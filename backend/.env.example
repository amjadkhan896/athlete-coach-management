# Backend settings. Copy to .env:  cp .env.example .env
# Used by `docker compose` and by `npm run start:dev`.
# These values work as-is for local Docker. Change every password and JWT_SECRET outside your machine.

# ── App ───────────────────────────────────────────────
# development | test | production  (production disables Swagger and the seed script)
NODE_ENV=development
# API port (inside the container and on your machine)
PORT=5001
# Browser origins allowed to call the API, comma-separated (the frontend URL)
CORS_ORIGIN=http://localhost:5000

# ── Database ──────────────────────────────────────────
# Address as seen from your machine. docker-compose overrides these for its own containers.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=acm
# Restricted user the API connects as (row-level security always applies)
DB_USER=acm_app
DB_PASSWORD=change-me-app
# Owner user for migrations and seeds (also the PostgreSQL admin user in Docker)
DB_MIGRATION_USER=acm_owner
DB_MIGRATION_PASSWORD=change-me-owner
# Maximum open database connections
DB_POOL_MAX=20
# Use TLS for the database connection (true for cloud databases)
DB_SSL=false

# ── Auth ──────────────────────────────────────────────
# Signing key for login tokens: at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
# Token lifetime (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN=1h
# Sign-in and password-change attempts allowed per minute per client
LOGIN_RATE_LIMIT=5

# ── Academy sign-up ───────────────────────────────────
# true: anyone can create an academy from the public sign-up page (they become its admin).
# false: only the platform operator can create academies.
ALLOW_ACADEMY_SIGNUP=true

# ── Platform operator ─────────────────────────────────
# Secret for onboarding new academies (POST /api/platform/academies with header X-Platform-Key).
# At least 32 characters. Leave empty to disable the platform endpoints.
PLATFORM_ADMIN_KEY=local-dev-platform-key-change-me-0123456789

# ── Demo data ─────────────────────────────────────────
# Password for all seeded demo accounts (development only)
SEED_PASSWORD=ChangeMe123!
