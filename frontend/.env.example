# Frontend settings. Copy to .env:  cp .env.example .env
# Used by `docker compose` and by `npm run dev`.

# Backend API address for `npm run dev`. (In Docker, docker-compose.yml uses http://api:5001.)
API_URL=http://localhost:5001

# Host port for the web app in Docker
WEB_PORT=5000

# Allow the login cookie over plain HTTP (true for local Docker on http://localhost).
# Leave empty in production, where the site is served over HTTPS.
INSECURE_COOKIES=true
